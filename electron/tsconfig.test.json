{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.electron-test.tsbuildinfo",
    "noEmit": true,
    // Tests run through Vitest as ES modules, not through the CommonJS main-process build.
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["**/*.test.ts", "test/**/*"],
  "exclude": []
}
